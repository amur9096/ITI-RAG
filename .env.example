# Backend Environment Configuration
PROJECT_NAME="RAG-Powered Document Assistant API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini API (Primary LLM - get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.6-flash

# llama-server / llama.cpp OpenAI-compatible endpoint (optional fallback)
LLAMA_SERVER_URL=http://127.0.0.1:11434

# Ollama LLM Configuration (optional fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60.0

# Vector Database & Embeddings
CHROMA_PATH=data/vector_store
CHROMA_COLLECTION_NAME=rag_documents
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
TOP_K=4
SIMILARITY_THRESHOLD=0.2

# CORS & Security
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
